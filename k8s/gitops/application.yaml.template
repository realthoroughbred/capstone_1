apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata: {name: team4-network, namespace: argocd}
spec:
  description: Only demo NetworkPolicies from the reviewed team4 repository.
  sourceRepos: ['${GITOPS_REPO_URL}']
  destinations:
    - {namespace: demo, server: 'https://kubernetes.default.svc'}
  clusterResourceWhitelist: []
  namespaceResourceWhitelist:
    - {group: networking.k8s.io, kind: NetworkPolicy}
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: team4-network
  namespace: argocd
spec:
  project: team4-network
  source:
    repoURL: ${GITOPS_REPO_URL}
    targetRevision: ${GITOPS_REVISION}
    path: policies/network
  destination:
    server: https://kubernetes.default.svc
    namespace: demo
  syncPolicy:
    automated:
      enabled: true
      selfHeal: true
      prune: true
      allowEmpty: false
    retry:
      limit: 5
      backoff: {duration: 5s, factor: 2, maxDuration: 1m}
