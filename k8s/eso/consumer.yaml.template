apiVersion: apps/v1
kind: Deployment
metadata: {name: secret-reader, namespace: demo}
spec:
  replicas: 1
  selector:
    matchLabels: {app: secret-reader}
  template:
    metadata:
      labels: {app: secret-reader, project: team4}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: test
          image: ${TEST_IMAGE}
          imagePullPolicy: IfNotPresent
          command: [sh, -c, 'while true; do sleep 3600; done']
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 10m, memory: 8Mi}
            limits: {cpu: 100m, memory: 32Mi}
          volumeMounts:
            - {name: token, mountPath: /var/run/demo-secret, readOnly: true}
      volumes:
        # Directory mount, not subPath: kubelet can propagate Secret rotations.
        - name: token
          secret: {secretName: team4-eso-demo, defaultMode: 0440}
