apiVersion: v1
kind: ServiceAccount
metadata:
  name: eso-secrets-reader
  namespace: demo
  annotations:
    eks.amazonaws.com/role-arn: ${ESO_ROLE_ARN}
automountServiceAccountToken: false
---
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata: {name: team4-aws, namespace: demo}
spec:
  provider:
    aws:
      service: SecretsManager
      region: ${AWS_REGION}
      auth:
        jwt:
          serviceAccountRef: {name: eso-secrets-reader}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata: {name: team4-eso-demo, namespace: demo}
spec:
  refreshInterval: 10s
  secretStoreRef: {name: team4-aws, kind: SecretStore}
  target: {name: team4-eso-demo, creationPolicy: Owner}
  data:
    - secretKey: token
      remoteRef:
        key: ${DEMO_SECRET_ARN}
        property: token
